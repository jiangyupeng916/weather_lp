# =============================================================================
# Guardian V8 环境变量模板（复制本文件为 .env.botN，按需取消注释/填值）
#
# 用法：实例名由启动方式决定（不是写在这个文件里）——
#   python main.py          → bot1（读 .env.bot1）
#   python main.py bot2     → bot2（读 .env.bot2）
#   INSTANCE=bot2 python main.py → bot2
#
# 说明：
#   - 除「私钥」外，其余参数都有默认值，不写 = 用默认值。
#   - 带「#」前缀的行是注释/模板，取消注释并填值才生效。
#   - 不要用行内注释（KEY=value # 注释）—— python-dotenv 会把「# 注释」解析进值。
# =============================================================================


# ── 账户凭据（必填）────────────────────────────────────────────────────────
# 两种账户格式，二选一：
#   【新账户】Deposit Wallet（2026-05-04 后标准账户）：
#       SIGNER_PRIVATE_KEY + POLYMARKET_WALLET_ADDRESS
#       + POLYMARKET_RELAYER_API_KEY + POLYMARKET_RELAYER_API_KEY_ADDRESS
#   【旧账户】POLY_PROXY（Magic/Google 登录）：
#       SIGNER_PRIVATE_KEY + PROXY_ADDRESS（无需 relayer）

# 私钥（必填，唯一必须项）。官方命名 SIGNER_PRIVATE_KEY，兼容旧短名 PK。
# 两者都设且内容不同会启动报错（防串号），只保留一套。
SIGNER_PRIVATE_KEY=

# 账户钱包地址（新账户必填）。官方命名 POLYMARKET_WALLET_ADDRESS，兼容 WALLET_ADDRESS。
#POLYMARKET_WALLET_ADDRESS=

# 旧账户代理地址（仅旧账户格式用）。
#PROXY_ADDRESS=

# Relayer API Key（新账户 gasless 钱包操作授权，两者配对，缺一不可）。
# 官方命名 POLYMARKET_RELAYER_API_KEY，兼容 RELAYER_API_KEY。
#POLYMARKET_RELAYER_API_KEY=
#POLYMARKET_RELAYER_API_KEY_ADDRESS=

# 历史遗留（无代码使用，SDK 自动派生 L2 凭据），保留仅为向后兼容，无需填写。
#CLOB_API_KEY=
#CLOB_SECRET=
#CLOB_PASS_PHRASE=


# ── 服务端点（可选，默认即可）──────────────────────────────────────────────
#CLOB_API_URL=https://clob.polymarket.com      # CLOB 服务地址（默认）
#GAMMA_API_URL=https://gamma-api.polymarket.com # gamma 数据服务地址（默认）
#CHAIN_ID=137                                  # 链 ID，Polygon 主网 = 137（默认）


# ── Maker 挂单策略 ──────────────────────────────────────────────────────────
#MAKER_SIZE=50        # 每单挂单量 USDC（默认 50）
#MAKER_RANK=2         # 挂买盘第几档：1=买一档，2=买二档（默认 2）；填非数字启动报错
#CANCEL_ON_TRADE=false # 「有成交就撤单」策略（默认 false，对所有档位生效）；
                       # 撤单后仍等 120s 冷却再重挂，故只适合成交稀疏的死水市场


# ── 内置筛选器（全部可选，以下为默认值）────────────────────────────────────
#SCREENER_INTERVAL=30             # 筛选器运行间隔秒（默认 30）
#SCREENER_KEYWORD=temp            # 关键词过滤（question 含该词才保留，默认 temp）
#SCREENER_TAGS=                   # 标签白名单，逗号分隔，命中任一保留；空=不过滤
#SCREENER_EXCLUDE_TAGS=           # 标签黑名单，逗号分隔，命中任一排除；空=不排除
#SCREENER_MIN_DAILY_REWARDS=10.0  # 每日返利下限（美元，默认 10.0）
#SCREENER_MIN_DAYS_TO_EXPIRY=0    # 到期天数下限（默认 0）
#SCREENER_MAX_DAYS_TO_EXPIRY=inf  # 到期天数上限（inf=不过滤，默认 inf）
#SCREENER_MIN_MIDPOINT=0.15       # 中位价下限（默认 0.15）
#SCREENER_MAX_MIDPOINT=0.85       # 中位价上限（默认 0.85）
#SCREENER_MIN_SIZE_LOWER=0.0      # rewards min_size 下限（默认 0.0）
#SCREENER_MIN_SIZE_UPPER=60       # rewards min_size 上限（默认 60）
#SCREENER_MIN_EXISTING_SIZE=2000.0 # 现有流动性下限（默认 2000.0）
#SCREENER_MIN_TOP1_BIDS=100.0     # 买一档深度下限（默认 100.0）
#SCREENER_MIN_TOP2_BIDS=400.0     # 买二档深度下限（默认 400.0）
#SCREENER_MIN_TOP3_BIDS=1200.0    # 买三档深度下限（默认 1200.0）

# 成交量/流动性过滤（gamma 补查；单位美元，market 级合计 YES+NO）：
#SCREENER_MIN_VOLUME_TOTAL=0      # 累计成交量下限（默认 0=不过滤）
#SCREENER_MAX_VOLUME_TOTAL=inf    # 累计成交量上限（inf=不过滤）
#SCREENER_MAX_VOLUME_24H=inf      # 近 24h 成交量上限（inf=不过滤）
#SCREENER_MAX_LIQUIDITY=inf       # 总流动性上限（inf=不过滤）

# 市场创建时间（age）过滤，单位小时：age = 现在 - createdAt：
#SCREENER_MIN_AGE_HOURS=0         # 年龄下限（过滤刚创建的新市场；默认 0=不过滤）
#SCREENER_MAX_AGE_HOURS=inf       # 年龄上限（过滤太老的市场；inf=不过滤）

# 挂单方向：both（默认，YES/NO 都挂）/ yes（只挂 YES）/ no（只挂 NO）。
# 只影响最终挂单，不影响评分/排序/CSV。
#SCREENER_OUTCOME=both


# ── 持仓卖出阈值 ────────────────────────────────────────────────────────────
#SELL_MIN_BID_GAP=0.02    # 即时卖单崩盘保护：best_bid < 成交价-此值 → 跳过（默认 0.02）
#SELL_POSITION_GAP=0.02   # 定时兜底崩盘保护：best_ask < 成本-此值 → 撤卖单等回稳（默认 0.02）


# ── 持仓超时强平（V8.4）────────────────────────────────────────────────────
#MAX_HOLD_ENABLED=true    # 超时强平开关（默认 true）
#MAX_HOLD_HOURS=4         # 持有超 N 小时未卖 → 无条件 FOK 市价全卖（默认 4）


# ── WebSocket ───────────────────────────────────────────────────────────────
#WS_MARKET_ENABLED=true   # 市场频道 WS 开关（默认 true；false 回退纯 REST 轮询）
#WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market  # 市场频道地址
#MARKET_PING_INTERVAL=10  # WS 心跳 PING 间隔秒（默认 10）
#MARKET_PING_TIMEOUT=50   # WS 心跳超时阈值秒，超时判定断线重连（默认 50）


# ── 日志 ────────────────────────────────────────────────────────────────────
#LOG_LEVEL=WARNING        # 文件日志级别（默认 WARNING；排查时临时改 INFO/DEBUG）


# ── 代理（可选，仅 WS 连接用；TUN 模式全局转发时勿设）────────────────────
# 程序按 HTTPS_PROXY > HTTP_PROXY > ALL_PROXY 顺序读取
#HTTPS_PROXY=
#HTTP_PROXY=
#ALL_PROXY=


# ── 已废弃 ──────────────────────────────────────────────────────────────────
#MARKET_FILE=             # 市场筛选文件（已废弃，由内置筛选器替代）
